SPOTIFY_CLIENT_ID=your_spotify_client_id
APP_URL=http://127.0.0.1:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_character_hex_secret

# Optional: set this to use a shared MongoDB catalog instead of the default local SQLite database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=sonic_sort
# Comma-separated Spotify user IDs allowed to browse the internal genre catalog.
GENRE_CATALOG_ADMIN_IDS=your_spotify_user_id
